# ============================================================
# EXTROVERT — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets.
# Production values belong in Vercel → Environment Variables.
# ============================================================


# ------------------------------------------------------------
# SUPABASE — PUBLIC CLIENT CONFIG
# ------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ------------------------------------------------------------
# APP IDENTITY
# ------------------------------------------------------------

NEXT_PUBLIC_APP_NAME=Extrovert

# Local development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production
# NEXT_PUBLIC_APP_URL=https://extrovert-nu.vercel.app


# ------------------------------------------------------------
# SUPABASE — SERVER-ONLY SECRETS
# ------------------------------------------------------------
# NEVER expose these through NEXT_PUBLIC_* variables.

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=


# ------------------------------------------------------------
# EXTROVERT OWNER
# ------------------------------------------------------------

DATEBU_OWNER_ID=


# ------------------------------------------------------------
# FEEDBACK
# ------------------------------------------------------------

NEXT_PUBLIC_FORMSPREE_ENDPOINT=


# ------------------------------------------------------------
# RAZORPAY
# ------------------------------------------------------------

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEEKLY_PLAN_ID=
RAZORPAY_MONTHLY_PLAN_ID=


# ------------------------------------------------------------
# OPTIONAL — RESEND
# ------------------------------------------------------------

# RESEND_API_KEY=


# ------------------------------------------------------------
# OPTIONAL — DIDIT IDENTITY VERIFICATION
# ------------------------------------------------------------

# DIDIT_API_KEY=
# DIDIT_WEBHOOK_SECRET=
# DIDIT_WORKFLOW_ID=


# ------------------------------------------------------------
# EXTROVERT URLS
# ------------------------------------------------------------
# Local + production allowlist used by server-side URL logic.

EXTROVERT_URL=http://localhost:3000,https://extrovert-nu.vercel.app


# ------------------------------------------------------------
# LEGACY BRIDGE — ONLY IF STILL REQUIRED
# ------------------------------------------------------------
# This should eventually be removed once all legacy compatibility
# code is gone. Never expose it to the browser.

# EXTROVERT_DATELOCAL_BRIDGE_SECRET=


# ------------------------------------------------------------
# UNIVERSITY / INSTITUTION — LEGACY / OPTIONAL
# ------------------------------------------------------------
# Extrovert is not restricted to one university.
# Leave these empty unless a specific feature still uses them.

# NEXT_PUBLIC_UNIVERSITY_NAME=
# NEXT_PUBLIC_UNIVERSITY_SHORT_NAME=
# NEXT_PUBLIC_UNIVERSITY_EMAIL_DOMAIN=


# ------------------------------------------------------------
# SUPABASE CLI
# ------------------------------------------------------------
# Keep the access token local only. Never commit it.

# SUPABASE_ACCESS_TOKEN=
# PROJECT_REF=zbdxhngtcuhmuxvptupu


# ------------------------------------------------------------
# AUTH CALLBACKS
# ------------------------------------------------------------
# Local:
# http://localhost:3000/callback
#
# Production:
# https://extrovert-nu.vercel.app/callback


# ------------------------------------------------------------
# LEGACY DATELocal REFERENCES — DO NOT ENABLE
# ------------------------------------------------------------
# The old DateLocal production URL is no longer used.
# https://datelocal.vercel.app
# https://extrovert-ten.vercel.app
# ============================================================
