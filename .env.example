# ===========================================
# DateBu — Environment Variables
# ===========================================
# Copy to .env.local and fill in values.
# NEVER commit .env.local or real secrets.

# --- Supabase (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — NEVER expose to browser) ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# --- Extrovert identity authority (server-only) ---
# Local: http://localhost:3000
# Production: your deployed Extrovert origin
EXTROVERT_URL=http://localhost:3000
EXTROVERT_DATEBU_BRIDGE_SECRET=

# --- University Branding (browser-safe) ---
NEXT_PUBLIC_UNIVERSITY_NAME=
NEXT_PUBLIC_UNIVERSITY_SHORT_NAME=
NEXT_PUBLIC_UNIVERSITY_EMAIL_DOMAIN=

# --- Application (browser-safe) ---
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=DateBu

# --- Razorpay (server-only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEEKLY_PLAN_ID=
RAZORPAY_MONTHLY_PLAN_ID=

# --- Optional local email testing ---
# Production authentication email delivery is configured in
# Supabase Dashboard > Authentication > SMTP Settings.
